---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogPage/BlogCard.tsx";
import PostPopup from "../components/BlogPage/PostPopup.astro";
import { fetchPosts } from "../utils/fetchPosts.ts";
import { fetchComments } from "../utils/fetchComments.ts";


const posts = await fetchPosts();
const comments = await fetchComments();
---

<BaseLayout>
  <main class="max-w-4xl mx-auto px-4 py-10 space-y-10 text-light-text dark:text-dark-text">
    <h1 class="text-3xl font-bold mb-8">Latest Posts</h1>

    {posts.map(async (post, i) => (
      <BlogCard client:only="react" post={post}>
        <PostPopup post={post} comments={comments.filter(c => c.post_id === post.id)} />
      </BlogCard>
    ))}
  </main>
</BaseLayout>
