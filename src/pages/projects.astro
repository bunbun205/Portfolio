---
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/ProjectsPage/Carousel";
import CategorySection from "../components/ProjectsPage/Categories";
import { fetchProjects } from "../utils/fetchProjects";

const projects = await fetchProjects();

---

<BaseLayout>
  <main class="px-4 py-10 text-light-text dark:text-dark-text max-w-4xl mx-auto space-y-16">
    <Carousel client:only="react" projects={projects} />

    <CategorySection client:only="react" category="3D Assets" projects={projects} delay={0.3} />
    <CategorySection client:only="react" category="Characters" projects={projects} delay={0.6} />
    <CategorySection client:only="react" category="Environments" projects={projects} delay={0.9} />
    <CategorySection client:only="react" category="Concept Art" projects={projects} delay={1.2} />
    <CategorySection client:only="react" category="Game Design" projects={projects} delay={1.5} />
    <CategorySection client:only="react" category="Game Development" projects={projects} delay={1.8} />
  </main>
</BaseLayout>